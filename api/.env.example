# LIFE.OS API configuration
# Copy this file to `.env` and fill in your own values.
# Never commit `.env` to GitHub — it contains secrets.

# A strong secret used to authenticate requests to your API.
# Generate one with:  python -c 'import secrets; print(secrets.token_urlsafe(40))'
PERSONAL_API_KEY=your-strong-secret-here

# Groq API key for AI Coach summaries (get one at https://groq.com)
GROQ_API_KEY=your-groq-api-key-here

# Database URL. SQLite is the default and works out of the box.
DATABASE_URL=sqlite:///./personal_life.db
